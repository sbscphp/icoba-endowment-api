APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:DFv/H3a6Z02DYWVHKMJSI6e+ccqDnGU893qD/wbBJ8Y=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_LOGIN_URL=https://icoba-endowment.netlify.app/login
# Base URL of the admin SPA. Used for admin-only links such as the invite "Set Your Password" email.
ADMIN_FRONTEND_URL=https://icoba-endowment-admin.onrender.com
# Optional full override; defaults to {ADMIN_FRONTEND_URL}/set-password. The reset token is appended as ?token=...
ADMIN_FRONTEND_SET_PASSWORD_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#------------------------------------- START SECURITY CONFIGURATION -------------------------------------
AUTH_OPAQUE_ERRORS= #null => use per-flow toggles below, true => force opaque errors, false => force explicit errors
LOGIN_OPAQUE_ERRORS=true
FORGOT_PASSWORD_OPAQUE_ERRORS=true
LOGIN_LOCK_ENABLED=false
LOGIN_LOCK_ATTEMPTS=3
LOGIN_LOCK_MINUTES=1440
LOGIN_REVEAL_PERMISSIONS=false
LAST_ACTIVE_UPDATE_INTERVAL_SECONDS=300

# OTP challenge (login + forgot-password): expiry and HTTP throttle windows (minutes must match)
OTP_MINUTES=5
OTP_SEND_MAX_PER_WINDOW=3
OTP_VERIFY_MAX_PER_WINDOW=20
# SMS OTP: disabled by default (uses OTP_SMS_STUB_CODE, no provider charges). Set true + SMS_PROVIDER when ready.
OTP_SMS_DISPATCH_ENABLED=false
OTP_SMS_STUB_CODE=123456

# When true, override users receive plaintext API payloads only after login (Bearer token). Login stays encrypted.
OVERRIDE_USERS=false

API_ENCRYPTION_MIDDLEWARE_ENABLED=false
API_ENCRYPTION_DEFAULT_MODE=both # both | request_only | response_only
# When true (default in local/dev/development/staging), encrypted HTTP responses may include a "preview" field with decoded JSON (never in production).
API_ENCRYPTION_RESPONSE_PREVIEW=true

# Developer: register API consumers (email with keys)
API_USER_DEV_REGISTRATION_ENABLED=false
API_USER_DEV_REGISTRATION_SECRET=

# ApiUserSeeder
API_USER_SEEDER_EMAIL=
API_USER_SEEDER_NAME=
API_USER_SEEDER_ENCRYPTION_MODE=both # both | request_only | response_only
API_USER_SEEDER_IS_ACTIVE=true
#------------------------------------- END SECURITY CONFIGURATION -------------------------------------

#------------------------------------- START CLOUDINARY CONFIGURATION -------------------------------------
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=
#------------------------------------- END CLOUDINARY CONFIGURATION -------------------------------------

#------------------------------------- START INFOBIP CONFIGURATION -------------------------------------
INFOBIP_BASE_URL=https://1vvgzx.api.infobip.com
INFOBIP_SECRET_KEY=""
INFOBIP_API_KEY=""
INFOBIP_SENDER="${APP_NAME}" # ICOBA Endowment
INFOBIP_TIMEOUT=120
#------------------------------------- END INFOBIP CONFIGURATION -------------------------------------

#------------------------------------- START TERMII CONFIGURATION -------------------------------------
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_API_KEY=
TERMII_MONTHLY_BUDGET_NGN=10000
TERMII_SENDER="${APP_NAME}" # ICOBA Endowment
TERMII_TIMEOUT=120
TERMII_ALERT_EMAILS=developer.iroayo@gmail.com
#------------------------------------- END TERMII CONFIGURATION -------------------------------------

# Stripe (donations — Checkout + webhooks). Use STRIPE_WEBHOOK_SECRET in all deployed environments.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Optional overrides; success URL must include Stripe’s {CHECKOUT_SESSION_ID} or we append ?session_id={CHECKOUT_SESSION_ID}
STRIPE_SUCCESS_URL=
# Redirect when checkout is cancelled or payment fails. Defaults to {FRONTEND_URL}/donate/failed
STRIPE_FAILED_URL=
# Deprecated alias for STRIPE_FAILED_URL
STRIPE_CANCEL_URL=

# Paystack (donations — Initialize + webhooks). Webhook URL: /api/v1/payment/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional override for Paystack redirect after payment. Paystack appends ?trxref= and &reference= automatically — do not use Stripe's {CHECKOUT_SESSION_ID} placeholder here.
PAYSTACK_CALLBACK_URL=
# Used by the frontend after verify when payment failed or was abandoned. Defaults to {FRONTEND_URL}/donate/failed
PAYSTACK_FAILED_URL=

# ICOBA Endowment receipt branding
ENDOWMENT_FOUNDATION_NAME="ICOBA Endowment Foundation"
ENDOWMENT_TAX_ID=12-3456789
ENDOWMENT_CONTACT_EMAIL=contact@icobaendowment.org
ENDOWMENT_WEBSITE=www.icobaendowment.org
ENDOWMENT_EXECUTIVE_DIRECTOR="Dr. Sarah Johnson"
ENDOWMENT_EXECUTIVE_DIRECTOR_TITLE="Executive Director"

# ExchangeRate-API (https://www.exchangerate-api.com)
# free = open.er-api.com, no key. paid = v6.exchangerate-api.com, requires EXCHANGE_RATE_API_KEY.
EXCHANGE_RATE_API_TIER=free
EXCHANGE_RATE_API_KEY=
# Paid tier only: url (key in path) or bearer (Authorization header, key omitted from URL).
EXCHANGE_RATE_PAID_AUTH=url
EXCHANGE_RATE_FETCH_INTERVAL_HOURS=4
EXCHANGE_RATE_STALE_ALERT_DAYS=2
EXCHANGE_RATE_ALERT_TO=adamilola@sbsc.com
EXCHANGE_RATE_ALERT_CC=juwonloiroayo@gmail.com