#------------------------------------- START SECURITY CONFIGURATION -------------------------------------
AUTH_OPAQUE_ERRORS= #null => use per-flow toggles below, true => force opaque errors, false => force explicit errors
LOGIN_OPAQUE_ERRORS=true
FORGOT_PASSWORD_OPAQUE_ERRORS=true
LOGIN_LOCK_ENABLED=false
LOGIN_LOCK_ATTEMPTS=3
LOGIN_LOCK_MINUTES=1440
LOGIN_REVEAL_PERMISSIONS=false
LAST_ACTIVE_UPDATE_INTERVAL_SECONDS=300

# OTP challenge (login + forgot-password): expiry and HTTP throttle windows (minutes must match)
OTP_MINUTES=5
OTP_SEND_MAX_PER_WINDOW=3
OTP_VERIFY_MAX_PER_WINDOW=20

API_ENCRYPTION_MIDDLEWARE_ENABLED=false
API_ENCRYPTION_DEFAULT_MODE=both # both | request_only | response_only
# When true (default in local/dev/development/staging), encrypted HTTP responses may include a "preview" field with decoded JSON (never in production).
API_ENCRYPTION_RESPONSE_PREVIEW=true

# Developer: register API consumers (email with keys)
API_USER_DEV_REGISTRATION_ENABLED=false
API_USER_DEV_REGISTRATION_SECRET=

# ApiUserSeeder
API_USER_SEEDER_EMAIL=
API_USER_SEEDER_NAME=
API_USER_SEEDER_ENCRYPTION_MODE=both # both | request_only | response_only
API_USER_SEEDER_IS_ACTIVE=true
#------------------------------------- END SECURITY CONFIGURATION -------------------------------------

