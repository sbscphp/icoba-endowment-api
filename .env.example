APP_NAME="NHEF Nexus"
APP_ENV=local
APP_KEY=base64:DFv/H3a6Z02DYWVHKMJSI6e+ccqDnGU893qD/wbBJ8Y=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost
FRONTEND_LOGIN_URL=
# Base URL of the admin SPA. Used for admin-only links such as the invite "Set Your Password" email.
ADMIN_FRONTEND_URL=
# Optional full override; defaults to {ADMIN_FRONTEND_URL}/create-new-password. The reset token is appended as ?token=...
ADMIN_FRONTEND_SET_PASSWORD_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Keep APP_TIMEZONE and DB_TIMEZONE aligned (UTC recommended) so OTP challenge expiry matches token TTL.
APP_TIMEZONE=UTC
DB_TIMEZONE=+00:00

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Throttle middleware uses this store (not CACHE_STORE). Use file or redis on MySQL — database causes deadlocks under concurrent requests.
CACHE_LIMITER_STORE=rate_limit
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#------------------------------------- START SECURITY CONFIGURATION -------------------------------------
AUTH_OPAQUE_ERRORS= #null => use per-flow toggles below, true => force opaque errors, false => force explicit errors
LOGIN_OPAQUE_ERRORS=true
FORGOT_PASSWORD_OPAQUE_ERRORS=true
LOGIN_LOCK_ENABLED=false
LOGIN_LOCK_ATTEMPTS=3
LOGIN_LOCK_MINUTES=1440
LOGIN_REVEAL_PERMISSIONS=false
# When true (recommended for production), a new login signs out other sessions for the same email.
ADMIN_INVALIDATE_TOKENS_ON_LOGIN=true
CUSTOMER_INVALIDATE_TOKENS_ON_LOGIN=true
LAST_ACTIVE_UPDATE_INTERVAL_SECONDS=300

# OTP challenge (login + forgot-password): expiry and HTTP throttle windows (minutes must match)
OTP_MINUTES=5
# Max minutes an old challenge_token stays valid on resend-otp endpoints (same purpose only).
OTP_RESEND_TOKEN_MAX_MINUTES=15
OTP_SEND_MAX_PER_WINDOW=3
OTP_VERIFY_MAX_PER_WINDOW=20
# Log OTP auth HTTP payloads (no passwords, OTP codes, or full tokens). Set true while debugging login/password reset.
OTP_FLOW_DEBUG=false
# SMS OTP: fixed code while OTP_SMS_DISPATCH_ENABLED=false; provider mode when true (log | live)
OTP_SMS_STUB_CODE=123456
OTP_SMS_DISPATCH_ENABLED=false
SMS_MODE=stub
SMS_FOREIGN_PROVIDER=twilio

# When true, override users receive plaintext API payloads only after login (Bearer token). Login stays encrypted.
OVERRIDE_USERS=false

API_ENCRYPTION_MIDDLEWARE_ENABLED=false
API_ENCRYPTION_DEFAULT_MODE=both # both | request_only | response_only
# When true (default in local/dev/development/staging), encrypted HTTP responses may include a "preview" field with decoded JSON (never in production).
API_ENCRYPTION_RESPONSE_PREVIEW=true

# Developer: register API consumers (email with keys)
API_USER_DEV_REGISTRATION_ENABLED=false
API_USER_DEV_REGISTRATION_SECRET=

# ApiUserSeeder
API_USER_SEEDER_EMAIL=
API_USER_SEEDER_NAME=
API_USER_SEEDER_ENCRYPTION_MODE=both # both | request_only | response_only
API_USER_SEEDER_IS_ACTIVE=true
#------------------------------------- END SECURITY CONFIGURATION -------------------------------------

#------------------------------------- START CLOUDINARY CONFIGURATION -------------------------------------
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=
#------------------------------------- END CLOUDINARY CONFIGURATION -------------------------------------

